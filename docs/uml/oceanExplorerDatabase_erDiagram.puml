@startchen

' =========================
' ENTITIES (persistente Daten)
' =========================

entity Ocean {
}

entity Sector {
}

entity Ship {
}

entity Submarine {
}

entity ShipScan {
}

entity ShipPosition {
}

entity SubmarineDive {
}

entity SubmarineReadyStatus {
}

entity SubmarineMeasurementPoint {
}

entity SubmarinePhoto {
}

entity Accident {
}

' =========================
' RELATIONSHIPS
' =========================

relationship HasSector {
}
relationship HasShip {
}

relationship Controls {
}

relationship ScanByShip {
}
relationship ScanOfSector {
}

relationship HasPosition {
}
relationship PositionInSector {
}

relationship HasDive {
}

relationship HasReadyStatus {
}

relationship HasMeasurementPoint {
}
relationship MeasurePointInSector {
}

relationship HasPhoto {
}

relationship AccidentOfShip {
}
relationship AccidentOfSubmarine {
}
relationship AccidentInSector {
}

' =========================
' CARDINALITIES
' =========================

Ocean -1- HasSector
HasSector -N- Sector

Ocean -1- HasShip
HasShip -N- Ship

Ship -1- Controls
Controls -N- Submarine
' (fachlich: max. 4 Submarines pro Ship – als Constraint, nicht als Chen-Kardinalität)

Ship -1- ScanByShip
ScanByShip -N- ShipScan

Sector -1- ScanOfSector
ScanOfSector -N- ShipScan

Ship -1- HasPosition
HasPosition -N- ShipPosition

Sector -1- PositionInSector
PositionInSector -N- ShipPosition

Submarine -1- HasDive
HasDive -N- SubmarineDive

SubmarineDive -1- HasReadyStatus
HasReadyStatus -N- SubmarineReadyStatus

SubmarineDive -1- HasMeasurementPoint
HasMeasurementPoint -N- SubmarineMeasurementPoint

Sector -1- MeasurePointInSector
MeasurePointInSector -N- SubmarineMeasurementPoint
' (Messpunkt hat absolute 3D-Koordinaten; Zuordnung zu Sector ist optional/ableitbar, aber für Abfragen hilfreich)

SubmarineDive -1- HasPhoto
HasPhoto -N- SubmarinePhoto
' (Foto: PNG -> Hex-String, Speicherung in DB)

Ship -1- AccidentOfShip
AccidentOfShip -N- Accident
' (Unfallpositionen Schiff)

Submarine -1- AccidentOfSubmarine
AccidentOfSubmarine -N- Accident
' (Unfallpositionen Submarine)

Sector -1- AccidentInSector
AccidentInSector -N- Accident

@endchen
